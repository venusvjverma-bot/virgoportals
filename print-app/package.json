{
  "name": "virgo-printing-app",
  "version": "1.0.0",
  "private": true,
  "main": "main.mjs",
  "description": "Virgo Portals receipt printing app for restaurants",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "winreg": "^1.2.5"
  },
  "build": {
    "appId": "com.virgoportals.printingapp",
    "productName": "Virgo Printing App",
    "files": ["main.mjs", "preload.cjs", "renderer/**/*"],
    "win": {
      "target": ["nsis"],
      "icon": "renderer/printer-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
